{
  "name": "roomledger-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:generate": "openapi-typescript ../../contracts/openapi.yaml -o src/app/generated/api-types.ts",
    "clean": "rm -rf dist .angular",
    "clean:node": "rm -rf node_modules",
    "start:fresh": "pnpm clean && pnpm install && pnpm build && pnpm start"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@aws-amplify/ui-angular": "^6.0.2",
    "angular-auth-oidc-client": "^22.0.2",
    "aws-amplify": "^6.22.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
