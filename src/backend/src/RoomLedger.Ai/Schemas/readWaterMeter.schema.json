{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "readWaterMeter",
  "type": "object",
  "additionalProperties": false,
  "required": ["readable", "value", "confidence", "note"],
  "properties": {
    "readable": { "type": "boolean", "description": "Ảnh có đọc được chỉ số hay không" },
    "value": { "type": ["integer", "null"], "minimum": 0, "description": "Phần nguyên của chỉ số; null nếu không đọc được" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "note": { "type": "string", "maxLength": 200 }
  }
}
